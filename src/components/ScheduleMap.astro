---
import { CEREMONY, RECEPTION } from '../site.config';

const hotelsMapsUrl =
  'https://www.google.com/maps/search/?api=1&query=Hotels+near+S+Ware+Rd,+McAllen,+TX+78501';
---

<div class="schedule-map-wrap">
  <svg
    class="schedule-map"
    viewBox="0 0 400 190"
    role="img"
    aria-labelledby="scheduleMapTitle scheduleMapDesc"
    preserveAspectRatio="xMidYMid meet"
  >
    <title id="scheduleMapTitle">Map of the wedding weekend along the US-83 corridor</title>
    <desc id="scheduleMapDesc">
      A schematic map showing the hotel cluster and ceremony in McAllen, about 10 minutes apart,
      and the reception in Donna, about 20 minutes east of McAllen along US-83.
    </desc>

    <!-- US-83 corridor -->
    <line x1="35" y1="120" x2="365" y2="120" class="schedule-map-road" />
    <text x="200" y="112" class="schedule-map-road-label" text-anchor="middle">US-83</text>

    <!-- Drive-time labels -->
    <text x="105" y="145" class="schedule-map-drivetime" text-anchor="middle">~10 min</text>
    <text x="260" y="145" class="schedule-map-drivetime" text-anchor="middle">~20 min</text>

    <!-- McAllen label -->
    <text x="90" y="30" class="schedule-map-city" text-anchor="middle">McAllen</text>
    <!-- Donna label -->
    <text x="330" y="30" class="schedule-map-city" text-anchor="middle">Donna</text>

    <!-- Hotel cluster pin -->
    <a href={hotelsMapsUrl} target="_blank" rel="noopener noreferrer" class="schedule-map-pin" aria-label="Hotel cluster in McAllen — open directions in Google Maps">
      <circle cx="50" cy="120" r="9" class="schedule-map-dot" />
      <text x="50" y="100" class="schedule-map-pin-label" text-anchor="middle">Hotels</text>
    </a>

    <!-- Ceremony pin -->
    <a href={CEREMONY.mapsUrl} target="_blank" rel="noopener noreferrer" class="schedule-map-pin" aria-label={`Ceremony — ${CEREMONY.name} — open directions in Google Maps`}>
      <circle cx="135" cy="120" r="9" class="schedule-map-dot" />
      <text x="135" y="100" class="schedule-map-pin-label" text-anchor="middle">Ceremony</text>
    </a>

    <!-- Reception pin -->
    <a href={RECEPTION.mapsUrl} target="_blank" rel="noopener noreferrer" class="schedule-map-pin" aria-label={`Reception — ${RECEPTION.name} — open directions in Google Maps`}>
      <circle cx="335" cy="120" r="9" class="schedule-map-dot" />
      <text x="335" y="100" class="schedule-map-pin-label" text-anchor="middle">Reception</text>
    </a>
  </svg>
</div>
